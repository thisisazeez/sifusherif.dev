# ─────────────────────────────────────────────────────────────
#  sifusherif — environment variables template
#  Copy to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

DJANGO_SETTINGS_MODULE=config.settings.production

# ── Django core ───────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-real-50-char-secret-key
DEBUG=False
ALLOWED_HOSTS=sifusherif.dev,www.sifusherif.dev

# ── Database — SQLite on named Docker volume ──────────────────
# DB_PATH takes priority in production; it must match the path
# used in the Docker volume mount (/app/data/db.sqlite3).
DB_PATH=/app/data/db.sqlite3

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1

# ── Email — Resend SMTP relay ─────────────────────────────────
# Docs: https://resend.com/docs/send-with-smtp
# EMAIL_HOST_USER is always "resend" (hardcoded in production.py)
# Just add your API key here when you're ready.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@sifusherif.dev

# ── DB Backup (backup service) ────────────────────────────────
# The email address that receives the nightly SQLite backup.
BACKUP_EMAIL_TO=your-personal-email@example.com

# ── Django superuser (created automatically on first deploy) ──
# The create_superuser_env command reads these and skips if the
# user already exists — safe to leave set on subsequent deploys.
DJANGO_SUPERUSER_USERNAME=sherif
DJANGO_SUPERUSER_EMAIL=sherif@sifusherif.dev
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password
